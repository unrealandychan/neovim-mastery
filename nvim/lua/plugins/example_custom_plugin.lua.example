return {
  -- --------------------------------------------------------------------------
  -- Example 1: Installing a new community plugin from GitHub
  -- (e.g. kylechui/nvim-surround for ys/ds/cs surround commands)
  -- --------------------------------------------------------------------------
  {
    "kylechui/nvim-surround",
    version = "*", -- Pin to release tags, or omit to follow main branch
    event = "VeryLazy", -- Load after UI startup for maximum speed
    opts = {
      -- Pass configuration options to nvim-surround here.
      -- Leaving this as an empty table {} uses all standard defaults:
      --   ysiw" -> surround word with quotes
      --   cs"'  -> change surrounding " to '
      --   ds"   -> delete surrounding quotes
    },
  },

